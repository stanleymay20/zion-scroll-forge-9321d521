# --- Required ---
# Shared secret between Supabase lecturer-bootstrap edge function and this worker.
# Must match LECTURER_WORKER_KEY in Lovable Cloud secrets.
LECTURER_WORKER_KEY=change-me

# Supabase service role for updating classroom_sessions.lecturer_bot_status.
# Used ONLY server-side inside this worker; never expose to clients.
SUPABASE_URL=https://klbtvdqfsctrfdkilrmx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- TTS provider ---
# One of: elevenlabs | text
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Default voice if tutor.voiceId is missing. George.
ELEVENLABS_DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Lecture script generation (Lovable AI Gateway) ---
# Worker calls the AI Gateway to draft the next lecture turn from pedagogy
# context. If unset, worker uses a deterministic fallback script.
LOVABLE_API_KEY=
LECTURER_MODEL=google/gemini-3-flash-preview

# --- Runtime ---
PORT=8080
LOG_LEVEL=info
# Max wall-clock seconds a single room session may run before forced shutdown.
MAX_SESSION_SECONDS=5400
